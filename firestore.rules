rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isHubMember(hubId) {
      return isSignedIn() && exists(/databases/$(database)/documents/hubs/$(hubId)) && (
        request.auth.uid == get(/databases/$(database)/documents/hubs/$(hubId)).data.ownerId ||
        request.auth.uid in get(/databases/$(database)/documents/hubs/$(hubId)).data.memberUids
      );
    }

    function isHubAdmin(hubId) {
      return isSignedIn() && exists(/databases/$(database)/documents/hubs/$(hubId)) && (
        request.auth.uid == get(/databases/$(database)/documents/hubs/$(hubId)).data.ownerId ||
        request.auth.uid in get(/databases/$(database)/documents/hubs/$(hubId)).data.adminUids
      );
    }

    function isValidHub(data) {
      return data.keys().hasAll(['name', 'ownerId', 'adminUids', 'memberUids', 'whitelistedEmails', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.ownerId is string && data.ownerId.size() > 0
        && data.adminUids is list
        && data.memberUids is list
        && data.whitelistedEmails is list
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidGroceryItem(data) {
      return data.keys().hasAll(['title', 'isCompleted'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 150
        && data.isCompleted is bool
        && (!('quantity' in data) || (data.quantity is number && data.quantity >= 0))
        && (!('category' in data) || (data.category is string))
        && (!('hubId' in data) || (data.hubId is string && data.hubId.size() > 0));
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['hubId', 'memberUids', 'title', 'startTime', 'endTime', 'category', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.hubId is string && data.hubId.size() > 0
        && data.memberUids is list
        && data.title is string && data.title.size() > 0 && data.title.size() <= 150
        && data.startTime is timestamp
        && data.endTime is timestamp
        && data.category is string && data.category.size() > 0
        && data.createdByUid is string && data.createdByUid.size() > 0
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMember(data) {
      return data.keys().hasAll(['hubId', 'uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.hubId is string && data.hubId.size() > 0
        && data.uid is string && data.uid.size() > 0
        && data.email is string && data.email.size() > 0
        && data.displayName is string && data.displayName.size() > 0
        && data.role in ['admin', 'member']
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll(['hubId', 'memberUids', 'userName', 'actionType', 'itemTitle', 'description', 'createdAt'])
        && data.hubId is string && data.hubId.size() > 0
        && data.memberUids is list
        && data.userName is string && data.userName.size() > 0
        && data.actionType is string && data.actionType.size() > 0
        && data.itemTitle is string
        && data.description is string
        && data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidChore(data) {
      return data.keys().hasAll(['hubId', 'memberUids', 'title', 'frequency', 'isCompleted', 'createdAt', 'updatedAt'])
        && data.hubId is string && data.hubId.size() > 0
        && data.memberUids is list
        && data.title is string && data.title.size() > 0 && data.title.size() <= 150
        && data.frequency is string
        && data.isCompleted is bool
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMealPlanDay(data) {
      return data.keys().hasAll(['hubId', 'memberUids', 'dateString', 'dayOfWeek', 'mealName', 'updatedAt'])
        && data.hubId is string && data.hubId.size() > 0
        && data.memberUids is list
        && data.dateString is string
        && data.dayOfWeek is string
        && data.mealName is string
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCustomMeal(data) {
      return data.keys().hasAll(['hubId', 'memberUids', 'name', 'costAndEffortTier', 'createdAt', 'updatedAt'])
        && data.hubId is string && data.hubId.size() > 0
        && data.memberUids is list
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.costAndEffortTier is string
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidHouseholdNote(data) {
      return data.keys().hasAll(['hubId', 'memberUids', 'title', 'content', 'authorName', 'createdAt', 'updatedAt'])
        && data.hubId is string && data.hubId.size() > 0
        && data.memberUids is list
        && data.title is string && data.title.size() > 0 && data.title.size() <= 150
        && data.content is string && data.content.size() <= 2000
        && data.authorName is string
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Hub Collection
    match /hubs/{hubId} {
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.memberUids ||
        (request.auth.token.email != null && request.auth.token.email in resource.data.whitelistedEmails)
      );

      allow create: if isSignedIn() && isValidHub(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        request.auth.uid in incoming().memberUids &&
        request.auth.uid in incoming().adminUids;

      allow update: if isSignedIn() && isValidHub(incoming()) &&
        incoming().ownerId == existing().ownerId && (
          request.auth.uid == existing().ownerId ||
          request.auth.uid in existing().adminUids ||
          (request.auth.uid in incoming().memberUids && (
            request.auth.uid in existing().memberUids ||
            (request.auth.token.email != null && request.auth.token.email in existing().whitelistedEmails)
          ))
        );

      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;

      // Grocery Subcollection
      match /groceries/{groceryId} {
        allow read: if isSignedIn() && (
          isHubMember(hubId) ||
          request.auth.uid in resource.data.memberUids
        );

        allow create: if isSignedIn() && isValidGroceryItem(incoming()) &&
          (isHubMember(hubId) || request.auth.uid in incoming().memberUids);

        allow update: if isSignedIn() && isValidGroceryItem(incoming()) &&
          (isHubMember(hubId) || request.auth.uid in resource.data.memberUids || request.auth.uid in incoming().memberUids);

        allow delete: if isSignedIn() && (
          isHubMember(hubId) ||
          request.auth.uid in resource.data.memberUids
        );
      }

      // Shared Household Grocery Favorites Subcollection
      match /grocery_favorites/{favoriteId} {
        allow read: if isSignedIn() && isHubMember(hubId);

        allow create: if isSignedIn() && isHubMember(hubId) &&
          incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 150;

        allow update: if isSignedIn() && isHubMember(hubId);

        allow delete: if isSignedIn() && isHubMember(hubId);
      }

      // Appointment Subcollection
      match /appointments/{appointmentId} {
        allow read: if isSignedIn() && (
          request.auth.uid in resource.data.memberUids ||
          isHubMember(hubId)
        );

        allow create: if isSignedIn() && isValidAppointment(incoming()) &&
          incoming().hubId == hubId &&
          incoming().createdByUid == request.auth.uid &&
          (request.auth.uid in incoming().memberUids || isHubMember(hubId));

        allow update: if isSignedIn() && isValidAppointment(incoming()) &&
          incoming().hubId == hubId &&
          (request.auth.uid in incoming().memberUids || isHubMember(hubId));

        allow delete: if isSignedIn() && (
          request.auth.uid in existing().memberUids ||
          isHubMember(hubId)
        );
      }

      // Members Subcollection
      match /members/{memberUid} {
        allow read: if isSignedIn() && isHubMember(hubId);

        allow create: if isSignedIn() && isValidMember(incoming()) &&
          incoming().hubId == hubId &&
          incoming().uid == request.auth.uid &&
          memberUid == request.auth.uid;

        allow update: if isSignedIn() && isValidMember(incoming()) &&
          incoming().hubId == hubId &&
          (request.auth.uid == memberUid || isHubAdmin(hubId));

        allow delete: if isSignedIn() && (
          request.auth.uid == memberUid ||
          isHubAdmin(hubId)
        );
      }

      // Activity Subcollection
      match /activity/{activityId} {
        allow read: if isSignedIn() && (
          request.auth.uid in resource.data.memberUids ||
          isHubMember(hubId)
        );

        allow create: if isSignedIn() && isValidActivityLog(incoming()) &&
          incoming().hubId == hubId &&
          (request.auth.uid in incoming().memberUids || isHubMember(hubId));

        allow delete: if isSignedIn() && isHubAdmin(hubId);
      }

      // Chores Subcollection
      match /chores/{choreId} {
        allow read: if isSignedIn() && (
          request.auth.uid in resource.data.memberUids ||
          isHubMember(hubId)
        );

        allow create: if isSignedIn() && isValidChore(incoming()) &&
          incoming().hubId == hubId &&
          (request.auth.uid in incoming().memberUids || isHubMember(hubId));

        allow update: if isSignedIn() && isValidChore(incoming()) &&
          incoming().hubId == hubId &&
          (request.auth.uid in incoming().memberUids || isHubMember(hubId));

        allow delete: if isSignedIn() && (
          request.auth.uid in existing().memberUids ||
          isHubMember(hubId)
        );
      }

      // Meal Plans Subcollection
      match /meal_plans/{dayId} {
        allow read: if isSignedIn() && (
          request.auth.uid in resource.data.memberUids ||
          isHubMember(hubId)
        );

        allow create, update: if isSignedIn() && isValidMealPlanDay(incoming()) &&
          incoming().hubId == hubId &&
          (request.auth.uid in incoming().memberUids || isHubMember(hubId));

        allow delete: if isSignedIn() && (
          request.auth.uid in existing().memberUids ||
          isHubMember(hubId)
        );
      }

      // Custom Meals Subcollection
      match /custom_meals/{mealId} {
        allow read: if isSignedIn() && (
          request.auth.uid in resource.data.memberUids ||
          isHubMember(hubId)
        );

        allow create: if isSignedIn() && isValidCustomMeal(incoming()) &&
          incoming().hubId == hubId &&
          (request.auth.uid in incoming().memberUids || isHubMember(hubId));

        allow update: if isSignedIn() && isValidCustomMeal(incoming()) &&
          incoming().hubId == hubId &&
          (request.auth.uid in incoming().memberUids || isHubMember(hubId));

        allow delete: if isSignedIn() && (
          request.auth.uid in existing().memberUids ||
          isHubMember(hubId)
        );
      }

      // Notes Subcollection
      match /notes/{noteId} {
        allow read: if isSignedIn() && (
          request.auth.uid in resource.data.memberUids ||
          isHubMember(hubId)
        );

        allow create: if isSignedIn() && isValidHouseholdNote(incoming()) &&
          incoming().hubId == hubId &&
          (request.auth.uid in incoming().memberUids || isHubMember(hubId));

        allow update: if isSignedIn() && isValidHouseholdNote(incoming()) &&
          incoming().hubId == hubId &&
          (request.auth.uid in incoming().memberUids || isHubMember(hubId));

        allow delete: if isSignedIn() && (
          request.auth.uid in existing().memberUids ||
          isHubMember(hubId)
        );
      }
    }
  }
}
